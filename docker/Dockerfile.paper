# 不用 # syntax 指令：它会直连 docker.io 拉 frontend 镜像，绕开 registry-mirror。
# ShadowFlow Paper Web —— 新版论文工作台（frontend/paper）→ nginx
#
# 生产入口就是本文件：docker-compose.yml 的 shadowflow-web 已指向 Dockerfile.paper。
# Dockerfile.web 是 legacy 前端的残留构建，仅供旧镜像对照（CI 不再构建它）。
#
# 运行期：静态站点 + /api 反代 shadowflow-node:8002（SSE 不缓冲）。

# alpine 的 musl node 在本机 WSL2 VM 里会 Segmentation fault，builder 换 glibc slim；
# runtime 的 nginx-alpine 无此问题，保持不动。
FROM docker.m.daocloud.io/library/node:20.14.0-slim AS builder

WORKDIR /app

# paper 的依赖声明在自己的 package.json（react / dicebear / lucide / xlsx + vite 工具链）；
# 没有 package-lock，因此用 npm install。构建所需依赖已全部声明，不再手工补装。
COPY frontend/paper/package.json ./frontend/paper/
RUN cd frontend/paper && npm install --no-audit --no-fund

COPY frontend/paper/tsconfig.json frontend/paper/vite.config.ts frontend/paper/index.html ./frontend/paper/
COPY frontend/paper/src ./frontend/paper/src

# 直接调 vite：容器里不必跑 tsc（类型与约定由 `npm run check` 在 CI 把关）。
RUN cd frontend/paper && npx vite build


FROM docker.m.daocloud.io/library/nginx:1.27.4-alpine AS runtime

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# 注意 location /api/ 里的 proxy_buffering off —— 群聊回复走 SSE，
# 缓冲会让「消息一条条冒出来」变成「最后一次性出现」。
# 这里显式写死 Connection "" 以支持 HTTP/1.1 长连接。
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINXCONF'
server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 100m;

  location /api/ {
    proxy_pass http://shadowflow-node:8002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
NGINXCONF

COPY --from=builder /app/frontend/paper/dist /usr/share/nginx/html
RUN chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && (chown appuser:appgroup /var/run 2>/dev/null || true)

USER appuser

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
