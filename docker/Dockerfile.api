# syntax=docker/dockerfile:1
# Story 0.1 — ShadowFlow API (Python / FastAPI)
# Multi-stage: builder installs pip deps, runtime keeps only site-packages + app code.

FROM python:3.11.9-slim AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /build

# Copy metadata first so dependency install layer caches across code changes.
COPY backend/python/pyproject.toml backend/python/README.md ./
COPY backend/python/shadowflow/__init__.py ./shadowflow/__init__.py

# Install the package plus [server] extras (FastAPI + uvicorn).
# 2026-08 0G 拆除后 zerog extra 已不存在，.[server,zerog] 会埋下安装隐患；只装 [server]。
RUN pip install --prefix=/install ".[server]"

# Pull in the rest of the source after deps are resolved.
COPY backend/python/shadowflow/ ./shadowflow/
RUN pip install --prefix=/install --no-deps .


FROM python:3.11.9-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/install/bin:${PATH}" \
    PYTHONPATH="/app/backend/python:/install/lib/python3.11/site-packages"

WORKDIR /app

# Non-root user for security (H4 fix)
RUN groupadd --system appgroup && useradd --system --gid appgroup appuser

# Copy the installed tree and app package from builder.
# 运行时布局镜像仓库拆分结构（backend/python/shadowflow + 根级 templates/），
# Path(__file__).parents[N] 锚点因此落在 /app —— .shadowflow/ 运行数据的家。
COPY --from=builder /install /install
COPY backend/python/shadowflow/ ./backend/python/shadowflow/
COPY templates/ ./templates/

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "shadowflow.server:app", "--host", "0.0.0.0", "--port", "8000"]
