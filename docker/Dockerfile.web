# syntax=docker/dockerfile:1
# Story 0.1 — ShadowFlow Web (Vite React → nginx)

FROM node:20.14.0-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
RUN cd frontend && npm ci

COPY frontend/tsconfig*.json frontend/vite.config.ts frontend/tailwind.config.ts frontend/postcss.config.js frontend/index.html ./frontend/
COPY frontend/public ./frontend/public
COPY frontend/src ./frontend/src

# Production bundle: call Vite directly so the container build does not block
# on pre-existing `tsc` failures in unrelated test files (vitest remains the
# type-checker of record for tests). Story 0.1 AC1 only requires a served SPA.
RUN cd frontend && npx vite build


FROM nginx:1.27.4-alpine AS runtime

# Non-root user for security (H4 fix)
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# nginx config: listen on 3000, SPA-rewrite to index.html, and reverse-proxy
# /api to shadowflow-node:8002 (Node Skill Studio, which forwards unmatched
# /api routes to shadowflow-api:8000). Without this proxy every /api call hit
# the SPA fallback and returned index.html — the app "started" but nothing
# worked. SSE/streaming needs buffering off + long read timeout.
RUN cat > /etc/nginx/conf.d/default.conf <<'NGINXCONF'
server {
  listen 3000;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  client_max_body_size 100m;

  location /api/ {
    proxy_pass http://shadowflow-node:8002;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
NGINXCONF

COPY --from=builder /app/frontend/dist /usr/share/nginx/html
# chown nginx runtime dirs so the non-root process can write pid/cache/log
RUN chown -R appuser:appgroup /usr/share/nginx/html /var/cache/nginx /var/log/nginx \
    && (chown appuser:appgroup /var/run 2>/dev/null || true)

USER appuser

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
