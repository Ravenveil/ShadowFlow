# ShadowFlow 环境配置模板
# 用法：复制本文件为 .env，按需填写；服务启动时自动读取（已存在的真实环境变量优先）。
# 注意：.env 含密钥，不要提交到 git（已在 .gitignore 忽略）。

# ========== 真实模型（接模型只用改这三行）==========
# OpenAI 兼容接口：base_url 结尾带不带 /v1 都行，程序会自动补齐到 /chat/completions。
# 取消注释其中一组并填上你的 key 即可。

# --- DeepSeek（国内可直连，性价比高，推荐起步用）---
# SF_LLM_BASE_URL=https://api.deepseek.com/v1
# SF_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SF_LLM_MODEL=deepseek-chat

# --- OpenAI ---
# SF_LLM_BASE_URL=https://api.openai.com/v1
# SF_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SF_LLM_MODEL=gpt-4o-mini

# --- 通义千问 DashScope（兼容模式）---
# SF_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# SF_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SF_LLM_MODEL=qwen-plus

# --- Kimi / Moonshot ---
# SF_LLM_BASE_URL=https://api.moonshot.cn/v1
# SF_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# SF_LLM_MODEL=moonshot-v1-8k

# 可选：温度与超时
# SF_LLM_TEMPERATURE=0.4
# SF_LLM_TIMEOUT=60

# ========== 服务端口 ==========
# SF_PORT=8787
# SF_HOST=127.0.0.1
# 要让局域网/手机访问，改成 SF_HOST=0.0.0.0，并务必设置管理令牌：
# SF_ADMIN_TOKEN=换成长随机串

# ========== 支付（默认模拟，不扣真钱）==========
# SF_PAY_MODE=simulated
