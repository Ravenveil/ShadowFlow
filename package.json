{
  "name": "shadowflow",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Visual Workflow Editor for AI Agents",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:web": "npm --prefix frontend run dev",
    "dev:python": "python -m uvicorn shadowflow.server:app --app-dir backend/python --host 127.0.0.1 --port 8000 --reload",
    "dev:python:docker": "docker compose -f docker/docker-compose.yml up shadowflow-api",
    "dev:server": "npm --prefix backend/node run dev",
    "build": "npm --prefix frontend run build",
    "preview": "npm --prefix frontend run preview",
    "test": "npm --prefix frontend run test",
    "test:run": "npm --prefix frontend run test:run && npm --prefix backend/node run test",
    "test:web": "npm --prefix frontend run test:run",
    "test:coverage": "npm --prefix frontend run test:coverage",
    "test:ui": "npm --prefix frontend run test:ui",
    "test:server": "npm --prefix backend/node run test",
    "lint": "eslint frontend/src frontend/tests backend/node/src tests --ext ts,tsx --max-warnings 0",
    "format": "npm --prefix frontend run format",
    "i18n:extract": "npm --prefix frontend run i18n:extract",
    "i18n:status": "npm --prefix frontend run i18n:status",
    "i18n:lint": "npm --prefix frontend run i18n:lint",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:translate:dry": "node scripts/i18n-translate.mjs --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
