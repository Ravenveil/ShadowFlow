{
  "name": "shadowflow",
  "version": "1.1.0",
  "private": true,
  "license": "MIT",
  "description": "Visual Workflow Editor for AI Agents",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:web": "npm --prefix frontend/legacy run dev",
    "dev:server": "npm --prefix backend/node run dev",
    "build": "npm --prefix frontend/legacy run build",
    "preview": "npm --prefix frontend/legacy run preview",
    "test": "npm --prefix frontend/legacy run test",
    "test:run": "npm --prefix frontend/legacy run test:run && npm --prefix backend/node run test && node scripts/run-script-tests.mjs",
    "test:web": "npm --prefix frontend/legacy run test:run",
    "test:scripts": "node scripts/run-script-tests.mjs",
    "test:scripts:list": "node scripts/run-script-tests.mjs --list",
    "test:coverage": "npm --prefix frontend/legacy run test:coverage",
    "test:ui": "npm --prefix frontend/legacy run test:ui",
    "test:server": "npm --prefix backend/node run test",
    "lint": "eslint frontend/legacy/src frontend/legacy/tests backend/node/src tests --ext ts,tsx --max-warnings 0 && node scripts/arch-check.mjs",
    "format": "npm --prefix frontend/legacy run format",
    "i18n:extract": "npm --prefix frontend/legacy run i18n:extract",
    "i18n:status": "npm --prefix frontend/legacy run i18n:status",
    "i18n:lint": "npm --prefix frontend/legacy run i18n:lint",
    "i18n:translate": "node scripts/i18n-translate.mjs",
    "i18n:translate:dry": "node scripts/i18n-translate.mjs --dry-run",
    "arch:check": "node scripts/arch-check.mjs",
    "dev:paper": "node scripts/dev.mjs --paper",
    "dev:paper:mock": "node scripts/dev.mjs --paper --mock",
    "test:paper": "npm --prefix frontend/paper run check",
    "dev:legacy": "node scripts/dev.mjs --legacy"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "tsx": "^4.7.0",
    "typescript": "^5.2.2"
  }
}
