# ShadowFlow environment — copy to .env before `docker compose -f docker/docker-compose.yml up`.
# NOTE (S1 red line): DO NOT commit real keys. Values MUST stay empty in this file.
# Per BYOK (bring-your-own-key) policy the primary API keys are stored in the
# browser's localStorage by the web UI. These server-side slots are optional
# and only used by backend-side features (offline bridge, CLI smoke, etc.).

# === LLM provider keys (optional on server; UI will prompt if absent) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# === Agent Pack Registry signing secret (Story 12.5 AC5) ===
# HMAC-SHA256 key for verifying official Pack manifests.
# Change to a strong random value in production.
SHADOWFLOW_PACK_SECRET=dev-secret-change-in-prod

# === CORS allow-list for the FastAPI server ===
# Comma-separated explicit origins. Wildcard "*" is NOT allowed (CORS spec violation
# when allow_credentials=True). Expand for production domains.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
