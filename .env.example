# 可选：需要大模型能力时填任意一个；不填则使用浏览器内 BYOK 输入
# MiMo（小米，OpenAI 兼容端点 https://api.xiaomimimo.com/v1，模型 mimo-v2.6-pro / mimo-v2.6-flash）
MIMO_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ── 小红书开放平台（real 发布链，auth_mode=real 的账号才真发）────────────────
# OAuth2 授权码流程（唯一需要浏览器登录的一步是①）：
#   ① GET  /api/social-publish/xhs/auth-url        → 浏览器打开授权页，登录并同意
#   ② 回调 redirect_uri 带回 ?code= → POST /api/social-publish/xhs/exchange {code}
#      → access_token（约 2h）+ refresh_token 自动写回本 .env
#   ③ access_token 过期后 POST /api/social-publish/xhs/refresh → 新值写回本 .env
#      （刷新无感，不需要浏览器；发布前已自动续期，见下 SP_XHS_REFRESH_MARGIN_MS）
SP_XHS_CLIENT_ID=
SP_XHS_CLIENT_SECRET=
# 可选：授权回调地址与 scope（须与开放平台应用配置一致）
SP_XHS_REDIRECT_URI=
SP_XHS_SCOPE=
# 以下由 exchange/refresh 自动写回，一般不用手填：
SP_XHS_ACCESS_TOKEN=
SP_XHS_REFRESH_TOKEN=
# SP_XHS_ACCESS_TOKEN_EXPIRES_AT=   （过期时间戳 epoch ms，自动写回，供自动续期判断）
# 可选：发布前自动续期的临期阈值（毫秒，默认 1800000 = 30 分钟；距过期不足即静默 refresh）
# SP_XHS_REFRESH_MARGIN_MS=1800000
# 可选：端点覆盖（默认 https://open.xiaohongshu.com 的 /oauth/authorize 与 /oauth/token）
# SP_XHS_OAUTH_BASE=
# SP_XHS_AUTHORIZE_URL=
# SP_XHS_TOKEN_URL=
